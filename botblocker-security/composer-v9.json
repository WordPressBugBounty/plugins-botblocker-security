{
    "name": "botblocker/security",
    "description": "BotBlocker Security Plugin for PHP >= 8.1",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "pragmarx/google2fa": "9.0.0",
        "paragonie/constant_time_encoding": "3.1.3",
        "maxmind-db/reader": "^1.13",
        "botblocker/mobiledetect-4": "^4.8",
        "globus-studio/phpqrcode": "^1.0"
    },
    "config": {
        "vendor-dir": "vendor/2FA/v9",
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable"
}
