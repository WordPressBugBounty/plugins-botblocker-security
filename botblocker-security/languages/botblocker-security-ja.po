#: includes/section/integration/botblocker-int-2fa.php:178
msgid "<strong>Note:</strong> After clicking \"Reset 2FA\", the user will need to set up 2FA again <strong>only if \"Enable Two-Factor Authentication\" is checked</strong>. They can do this immediately (QR code will appear) or on their next login."
msgstr "<strong>注意:</strong>「2FAをリセット」をクリックした後、<strong>「二要素認証を有効にする」がチェックされている場合のみ</strong>、ユーザーは再度2FAを設定する必要があります。すぐに（QRコードが表示されます）または次回ログイン時に行えます。"

#. translators: %s: Link to the Paths tab URL.
#: admin/partials/botblocker-admin-display-rules.php:352
#, php-format
msgid "<strong>Paths:</strong> Add payment gateway callback endpoints under %s to prevent them from being blocked."
msgstr "<strong>パス:</strong> 支払いゲートウェイのコールバックエンドポイントを %s の下に追加して、ブロックされないようにします。"

#. translators: %s: Link to the Proxy tab URL.
#: admin/partials/botblocker-admin-display-rules.php:376
#, php-format
msgid "<strong>Proxy:</strong> Add network masks or header patterns (e.g., Cloudflare ranges) in %s."
msgstr "<strong>プロキシ:</strong> ネットワークマスクまたはヘッダーパターン（例：Cloudflareの範囲）を %s に追加します。"

#. translators: %s: Link to the Rules tab URL.
#: admin/partials/botblocker-admin-display-rules.php:364
#, php-format
msgid "<strong>Rules:</strong> Create rules in %s for IP, User-Agent, ASN, country, referrer, path, cookie, header, request method, or bot score."
msgstr "<strong>ルール:</strong> IP、User-Agent、ASN、国、リファラー、パス、Cookie、ヘッダー、リクエストメソッド、またはボットスコアのルールを %s で作成します。"

#. translators: %s: Link to the White Bots tab URL.
#: admin/partials/botblocker-admin-display-rules.php:370
#, php-format
msgid "<strong>White Bots:</strong> Add trusted crawler domains (search engines, social networks, uptime monitors) under %s."
