#. translators: %s: Link to the Rules tab URL.
#: admin/partials/botblocker-admin-display-rules.php:364
#, php-format
msgid "<strong>Rules:</strong> Create rules in %s for IP, User-Agent, ASN, country, referrer, path, cookie, header, request method, or bot score."
