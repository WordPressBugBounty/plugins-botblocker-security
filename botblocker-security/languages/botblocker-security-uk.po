#: admin/templates/integrations/2fa.php:109
#: includes/section/integration/botblocker-int-2fa.php:178
msgid "<strong>Note:</strong> After clicking \"Reset 2FA\", the user will need to set up 2FA again <strong>only if \"Enable Two-Factor Authentication\" is checked</strong>. They can do this immediately (QR code will appear) or on their next login."
msgstr "<strong>Примітка:</strong> Після натискання кнопки \"Скинути 2FA\" користувачеві потрібно буде заново налаштувати 2FA <strong>лише в тому випадку, якщо встановлено прапорець \"Увімкнути двофакторну автентифікацію\"</strong>. Це можна зробити одразу (з’явиться QR-код) або під час наступного входу в систему."

#. translators: %s: Link to the Paths tab URL.
#: admin/partials/botblocker-admin-display-rules.php:352
#, php-format
msgid "<strong>Paths:</strong> Add payment gateway callback endpoints under %s to prevent them from being blocked."
msgstr "<strong>Шляхи:</strong> Додайте посилання на колбеки платіжного шлюзу в %s, щоб запобігти їх блокуванню."

#. translators: %s: Link to the Proxy tab URL.
#: admin/partials/botblocker-admin-display-rules.php:376
#, php-format
msgid "<strong>Proxy:</strong> Add network masks or header patterns (e.g., Cloudflare ranges) in %s."
