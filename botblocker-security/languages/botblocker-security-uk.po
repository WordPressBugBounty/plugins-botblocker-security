#: admin/templates/integrations/wp-abilities.php:38
msgid "botblocker/block-ip — adds a firewall block rule and regenerates the runtime ban files. Destructive, requires manage_options."
msgstr "botblocker/block-ip – додає правило блокування брандмауера та повторно генерує файли банів під час виконання. Деструктивна дія, потребує manage_options."

#: admin/templates/integrations/wp-abilities.php:29
msgid "botblocker/check-ip — checks an IP address against the firewall rules and returns the matched rules."
msgstr "botblocker/check-ip – перевіряє IP-адресу на відповідність правилам брандмауера та повертає знайдені правила."

#: admin/templates/integrations/wp-abilities.php:28
msgid "botblocker/get-firewall-status — returns the protection mode, enabled state and plugin version."
msgstr "botblocker/get-firewall-status – повертає режим захисту, стан увімкнення та версію плагіна."

#: admin/templates/integrations/wp-abilities.php:30
msgid "botblocker/get-ip-rules — returns the firewall rules matching a given IP address."
msgstr "botblocker/get-ip-rules – повертає правила брандмауера, що відповідають заданій IP-адресі."

#: admin/templates/integrations/wp-abilities.php:47
msgid "botblocker/get-scan-results — returns the status and findings of the latest malware scan."
msgstr "botblocker/get-scan-results – повертає стан і результати останнього сканування на зловредне програмне забезпечення."

#: admin/templates/integrations/wp-abilities.php:31
msgid "botblocker/get-traffic-summary — aggregated request, block, captcha, suspicious and proxy counters."
msgstr "botblocker/get-traffic-summary – агреговані лічильники запитів, блокувань, captcha, підозрілих і проксі."

#: admin/templates/integrations/wp-abilities.php:32
msgid "botblocker/run-diagnostics — read-only health checks for the data directory and database tables."
msgstr "botblocker/run-diagnostics – перевірки стану лише для читання для директорії даних і таблиць бази даних."

#: admin/templates/integrations/wp-abilities.php:46
msgid "botblocker/run-malware-scan — starts a background malware scan through the Malware Scanner add-on."
msgstr "botblocker/run-malware-scan – запускає фонове сканування на зловредне програмне забезпечення через додаток Malware Scanner."

#: admin/templates/integrations/wp-abilities.php:39
msgid "botblocker/unblock-ip — removes firewall rules for an IP address and regenerates the runtime ban files. Destructive, requires manage_options."
msgstr "botblocker/unblock-ip – видаляє правила брандмауера для IP-адреси та повторно генерує файли банів під час виконання. Деструктивна дія, потребує manage_options."

